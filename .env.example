# Database
DATABASE_URL="postgresql://user:password@host:5432/gulel_ott"

# Supabase
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Cloudflare Stream
CLOUDFLARE_ACCOUNT_ID="your-account-id"
CLOUDFLARE_API_TOKEN="your-api-token"
NEXT_PUBLIC_CLOUDFLARE_CUSTOMER_SUBDOMAIN="your-subdomain.cloudflarestream.com"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Razorpay (India payments — optional; INR falls back to Stripe if unset)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="your-secret"
RAZORPAY_WEBHOOK_SECRET="your-webhook-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_..."

# RevenueCat (mobile in-app purchases — App Store / Play Store)
# Webhook authorization value: set this to the exact "Authorization" header
# value configured in the RevenueCat dashboard (it is sent verbatim).
REVENUECAT_WEBHOOK_SECRET="set-a-long-random-string"
# Secret (server) API key — used to delete the RevenueCat customer record when a
# user deletes their account. Optional; unset = that step is skipped.
REVENUECAT_SECRET_API_KEY="sk_..."

# Sign in with Apple token revocation — REQUIRED for App Store account-deletion
# compliance (Guideline 5.1.1(v)). Without these the server cannot exchange the
# app's authorization code for a refresh token, so deleting an account does NOT
# revoke the Apple grant. Create a "Sign in with Apple" key in the Apple
# Developer portal (Keys) and paste the .p8 contents with newlines as "\n".
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# Optional: defaults to the iOS bundle ID com.gulel.app.
APPLE_CLIENT_ID="com.gulel.app"

# Ads (Google IMA rewarded video — optional)
# VAST/VMAP ad tag URL from Google Ad Manager for the rewarded "Watch Ad to Earn Coins" flow.
# When unset, the "Watch Ad" option is hidden entirely (no path to free coins).
NEXT_PUBLIC_IMA_REWARDED_AD_TAG_URL=""
#
# Rewarded-ad coins are granted ONLY by Google's Server-Side Verification (SSV)
# callback — never by the client. In your AdMob/Ad Manager rewarded ad unit,
# set the SSV callback URL to:
#   https://thegulel.com/api/ads/ssv
# We pass the Gulel userId to Google as `custom_data` on the ad request; Google
# echoes it back to the callback so we know which user to credit. The callback
# verifies Google's signature against the public verifier keys, then grants
# coins once per transaction_id (idempotent) with a per-user cooldown.
#
# Optional allowlist of rewarded ad units that may grant coins (comma-separated).
# Either the full AdMob id ("ca-app-pub-7686596859294513/6574059853") or just
# the numeric part Google sends in the callback ("6574059853") is accepted.
# Empty = any ad unit (a warning is logged).
ADMOB_SSV_AD_UNITS=""
# Max rewarded ads credited per user per UTC day (default 10).
ADS_DAILY_CAP=""

# Analytics & ads measurement (all optional — each tag is skipped when unset)
# GA4 measurement ID (G-…). Receives the funnel events (video_start, paywall_view,
# sign_up, begin_checkout, purchase, …) with last-touch UTMs as event params.
NEXT_PUBLIC_GA_ID=""
# Google Tag Manager web container (GTM-…).
NEXT_PUBLIC_GTM_ID=""
# Meta Pixel / dataset ID. Browser events carry an eventID so they dedupe with
# the server-side Conversions API events below.
NEXT_PUBLIC_FB_PIXEL_ID=""
#
# Meta Conversions API (server only). Payment webhooks (Stripe, Razorpay,
# RevenueCat) send Purchase / Subscribe with the same event_id as the browser.
# Disabled unless this token and a pixel ID (either variable) are set.
# Events Manager → dataset → Settings → Conversions API → Generate access token.
META_CAPI_ACCESS_TOKEN=""
# Optional: dataset ID for server events when it differs from NEXT_PUBLIC_FB_PIXEL_ID.
META_PIXEL_ID=""
# Optional, testing only: routes server events to Events Manager → Test events
# (also lets test-mode Stripe/Razorpay/RevenueCat sandbox payments through).
# Remove once verified.
META_CAPI_TEST_EVENT_CODE=""

# SMS/OTP Provider (Twilio example)
TWILIO_ACCOUNT_SID="your-account-sid"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"

# JWT
JWT_SECRET="your-jwt-secret-key-minimum-32-characters-long"

# CORS — comma-separated origins allowed to call the JSON API cross-origin
# (e.g. the Expo web preview). Native mobile needs nothing here. Leave empty
# for same-origin only. Example: "http://localhost:8081,https://app.gulel.com"
CORS_ALLOWED_ORIGINS=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Gulel OTT"

# Admin
ADMIN_PHONE="+919876543210"

# Site health audit cron (/api/cron/audit, scheduled in vercel.json)
# CRON_SECRET secures the endpoint — Vercel Cron sends it as a Bearer token.
CRON_SECRET="generate-a-long-random-string"
# Optional: POST a summary to Slack/Discord when the audit finds errors.
AUDIT_WEBHOOK_URL=""

# Operator maintenance endpoint (/api/admin/ops): dbcheck, migrate,
# cleanup-demo, ingest (copy a video URL into Cloudflare Stream as an episode).
# Unset = endpoint disabled. Rotate after use; treat like a password.
OPS_TOKEN="generate-a-long-random-string"
