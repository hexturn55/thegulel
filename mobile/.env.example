# Gulel mobile (Expo) environment.
# Copy to `.env`. Only EXPO_PUBLIC_* vars are exposed to the app bundle.
# Every value is optional: anything left empty falls back to app.json `extra`
# (see lib/config.ts). This file is for local dev only: EAS cloud builds never
# see it. EAS build profiles set their own values in eas.json `env` (or EAS
# environment variables); the RevenueCat keys below MUST be provided that way
# (or via app.json extra) for store submissions — app.config.js warns in the
# production build log if they are missing (GULEL_REQUIRE_IAP_KEYS=1 makes it fail).

# Base URL of the deployed Gulel web/API (Next.js app).
EXPO_PUBLIC_API_URL="https://thegulel.com"

# Supabase (same project as the web app; use the anon/public key here).
EXPO_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# RevenueCat public SDK keys (App Store / Play Store IAP).
EXPO_PUBLIC_RC_IOS_KEY="appl_..."
EXPO_PUBLIC_RC_ANDROID_KEY="goog_..."

# AdMob rewarded ad unit ids ("watch a video for coins"), per platform.
# Android falls back to the baked-in production unit. iOS has NO fallback:
# leave it empty and rewarded ads stay hidden on iOS release builds.
# The iOS unit is IGNORED while app.json's react-native-google-mobile-ads
# `iosAppId` is still Google's sample app id (ca-app-pub-3940256099942544~...):
# replace it with the real iOS AdMob app id (and rebuild) in the same change.
EXPO_PUBLIC_ADMOB_REWARDED_ID_ANDROID="ca-app-pub-7686596859294513/6574059853"
EXPO_PUBLIC_ADMOB_REWARDED_ID_IOS=""

# Set to "1" to serve Google's test ad units instead of the real ones.
# Dev-server builds (__DEV__) always use test units. Release builds use real
# units unless this is "1" — the development and preview profiles in eas.json
# set it; production must not.
EXPO_PUBLIC_ADMOB_TEST_ADS=""

# Build environment label: "development" | "preview" | "production".
# Defaults to "production" when unset.
EXPO_PUBLIC_APP_ENV="development"
